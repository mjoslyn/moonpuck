---
// A monthly donor (src/lib/donations/donations.ts): their gift each month, its status at Stripe, the gifts
// it has made, and Cancel (admins: the subscription ends at Stripe and the donor is emailed) and Check at
// Stripe (its status read again). POST /api/admin/donations.
import Admin from '../../../../layouts/Admin.astro';
import { SITE_TZ } from '../../../../lib/site';
import { formatMoney } from '../../../../lib/payments/money';
import { donationSettings } from '../../../../lib/donations/config';
import { atHome, type Donation, type DonationPlan } from '../../../../lib/donations/donations';

const id = Number(Astro.params.id) || 0;
const db = Astro.locals.db;
const { data } = await db.from('donation_plans').select('*').eq('id', id).maybeSingle();
if (!data) return Astro.redirect('/admin/donations/?tab=monthly');
const p = data as DonationPlan;
const { data: giftRows } = await db.from('donations').select('*').eq('plan_id', p.id).order('id', { ascending: false }).limit(200);
const gifts = (giftRows ?? []) as Donation[];
const { data: siteRow } = await db.from('settings').select('value').eq('key', 'site').maybeSingle();
const s = donationSettings(siteRow?.value as any);
const isAdmin = Astro.locals.user?.role === 'admin';
const money = (n: number) => formatMoney(n, p.currency);
const when = (x: string | null) => (x ? new Date(x).toLocaleString('en-US', { timeZone: SITE_TZ, month: 'short', day: 'numeric', year: 'numeric' }) : '');
const STATUS: Record<string, string> = { incomplete: 'Not started', active: 'Active', past_due: 'The last payment failed; Stripe tries again', cancelled: 'Cancelled' };
const home = atHome(p, Astro.url.origin);
const live = (p.status === 'active' || p.status === 'past_due') && home;
const paid = gifts.filter((g) => g.status === 'paid');
---
<Admin title={`Monthly gift: ${p.name}`}>
  <p class="text-sm"><a class="text-admin-muted hover:text-admin-accent" href="/admin/donations/?tab=monthly">← Monthly donors</a></p>
  <h1 class="mt-2 text-3xl font-normal">{p.name}: {money(p.total)} a month</h1>
  <p class="mt-1 text-sm text-admin-muted">{STATUS[p.status] ?? p.status}{p.started_at ? ` · since ${when(p.started_at)}` : ''}{p.cancelled_at ? ` · cancelled ${when(p.cancelled_at)}` : ''}</p>
  <section class="mt-6 rounded bg-white p-4 text-sm shadow-[0_0_0_1px_rgba(26,26,46,0.08)]">
    <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2">
      <dt class="text-admin-muted">Email</dt><dd><a class="underline" href={`mailto:${p.email}`}>{p.email}</a></dd>
      <dt class="text-admin-muted">Gift</dt><dd>{money(p.amount)}{p.fee ? ` + ${money(p.fee)} fees` : ''}</dd>
      <dt class="text-admin-muted">Given so far</dt><dd>{money(paid.reduce((a, g) => a + g.amount, 0))} in {paid.length} {paid.length === 1 ? 'month' : 'months'}</dd>
      {p.dedication && <><dt class="text-admin-muted">In honor or memory of</dt><dd>{p.dedication}</dd></>}
      {p.goal && <><dt class="text-admin-muted">Goal</dt><dd>{s.goals.find((g) => g.id === p.goal)?.name ?? p.goal}</dd></>}
      <dt class="text-admin-muted">Stripe subscription</dt><dd>{p.subscription ?? 'none yet'}</dd>
      {p.home && <><dt class="text-admin-muted">Started on</dt><dd>{p.home}{!home && <span class="text-[#b45309]"> (another copy of the site: its payments and changes are looked after there)</span>}</dd></>}
    </dl>
  </section>
  <section class="mt-4 flex flex-wrap gap-3">
    {p.subscription && home && <button type="button" data-plan="refresh" class="rounded border border-admin-ink/15 bg-white px-3 py-1.5 text-sm hover:border-admin-accent hover:text-admin-accent">Check at Stripe</button>}
    {isAdmin && live && <button type="button" data-plan="cancel" class="rounded border border-[#b3261e]/40 bg-white px-3 py-1.5 text-sm text-[#b3261e] hover:border-[#b3261e]">Cancel monthly gift</button>}
  </section>
  <p id="plan-status" role="status" class="mt-3 text-sm text-admin-muted"></p>

  <h2 class="mt-8 text-lg font-medium">Gifts</h2>
  <div class="mt-2 overflow-x-auto rounded bg-white shadow-[0_0_0_1px_rgba(26,26,46,0.08)]">
    <table class="w-full text-sm">
      <tbody>
        {gifts.map((g) => (
          <tr class="border-b border-admin-ink/5 last:border-0"><td class="px-4 py-2"><a class="hover:text-admin-accent" href={`/admin/donations/${g.id}/`}>{g.code}</a></td><td class="px-4 py-2 text-admin-muted">{when(g.paid_at ?? g.created_at)}</td><td class="px-4 py-2">{money(g.total)}</td><td class="px-4 py-2 text-admin-muted">{g.status}</td></tr>
        ))}
        {!gifts.length && <tr><td class="px-4 py-6 text-center text-admin-muted">No gifts yet.</td></tr>}
      </tbody>
    </table>
  </div>
</Admin>

<script define:vars={{ planId: p.id }}>
  const status = document.getElementById('plan-status');
  document.querySelectorAll('[data-plan]').forEach((b) =>
    b.addEventListener('click', async () => {
      const action = b.dataset.plan;
      if (action === 'cancel' && !confirm('Cancel this monthly gift? Stripe stops charging the donor, and they are emailed.')) return;
      status.textContent = 'Working…';
      const res = await fetch('/api/admin/donations', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ plan: planId, action: action === 'cancel' ? 'cancel-plan' : 'refresh-plan' }) });
      status.textContent = '';
      if (!res.ok) return alert(await res.text());
      location.reload();
    }),
  );
</script>
