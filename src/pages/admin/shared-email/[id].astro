---
// A newsletter draft edited through a share link (src/lib/share): only its guest reaches this page (the
// middleware's guestMay); editors use the campaign screen. Read as the server: the guest role reads no
// campaigns.
import { siteDb } from '../../../lib/db/site';
import { SITE_TZ, appliedTypeSettings, site } from '../../../lib/site';
import { mailingSettings } from '../../../lib/mailing/config';
import { siteTheme } from '../../../lib/theme/site';
import AdminTheme from '../../../layouts/AdminTheme.astro';
import '../../../styles/tailwind.css';
import '../../../styles/admin.css';
import SharedEmailEditor from '../../../admin/SharedEmailEditor';

const id = Number(Astro.params.id);
if (Astro.locals.user.role !== 'guest' || Astro.locals.share?.campaign_id !== id) return Astro.redirect(`/admin/mailing-lists/campaigns/${id}/`);
const db = siteDb();
const { data: c } = await db.from('campaigns').select('id, name, subject, design, text, status, updated_at').eq('id', id).maybeSingle();
if (!c || c.status !== 'draft') return new Response('This newsletter can’t be changed now.', { status: 404 });
const { data: siteRow } = await db.from('settings').select('value').eq('key', 'site').maybeSingle();
const fields = mailingSettings(siteRow?.value).fields ?? [];
const siteThemeNow = siteTheme(siteRow?.value);
Astro.response.headers.set('Cache-Control', 'no-store');
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <script is:inline define:vars={{ siteTz: SITE_TZ, siteTypes: appliedTypeSettings(), siteThemeNow }}>window.__siteTz = siteTz; window.__siteTypes = siteTypes; window.__siteTheme = siteThemeNow;</script>
    <AdminTheme />
    <title>{`Edit · ${c.name || 'Newsletter'} · ${site.name}`}</title>
  </head>
  <body class="bg-admin-soft font-admin">
    <SharedEmailEditor client:only="react" campaign={{ id: c.id, name: c.name, subject: c.subject, design: c.design, text: c.text, updated_at: c.updated_at }} fields={fields} label={Astro.locals.share?.label ?? ''} />
  </body>
</html>
