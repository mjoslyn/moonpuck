---
// moonpuck.com's home page. The docs (Starlight) are everything else on the site.
const FONTS =
  'https://fonts.googleapis.com/css2?family=Roboto+Serif:ital,opsz,wdth,wght@0,8..144,50..150,300..700;1,8..144,50..150,300..700&family=Instrument+Sans:wght@400;500;600;700&display=swap';
// The share card (public/og.png), also on every docs page (astro.config.mjs).
const SHARE_ALT = 'Moonpuck, the opinionated, batteries-included CMS: everything your site needs, on Cloudflare.';
const description =
  'Moonpuck is an opinionated, batteries-included open source CMS built on Cloudflare. A visual editor, events, tickets, members, mailing lists, donations, a shop and Claude come with it, on your own Cloudflare account.';
// Turnstile's site key for the contact form (public; its secret is the Worker's). Cloudflare's always-passing
// test key under astro dev.
const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || (import.meta.env.DEV ? '1x00000000000000000000AA' : '');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Moonpuck: the batteries-included CMS on Cloudflare</title>
<meta name="description" content={description}>
<link rel="canonical" href="https://moonpuck.com/">
<meta property="og:type" content="website">
<meta property="og:url" content="https://moonpuck.com/">
<meta property="og:site_name" content="moonpuck">
<meta property="og:title" content="Moonpuck: the batteries-included CMS on Cloudflare">
<meta property="og:description" content={description}>
<meta property="og:image" content="https://moonpuck.com/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={SHARE_ALT}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https://moonpuck.com/og.png">
<meta name="twitter:image:alt" content={SHARE_ALT}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href={FONTS}>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<style is:global>
body{margin:0;background:#2350E6}
a{color:#120C1F}a:hover{color:#000000}
.mp-wrap{max-width:1180px;margin:0 auto;padding-inline:40px;box-sizing:border-box;position:relative}
.mp-serif{font-family:'Roboto Serif',Georgia,serif;font-variation-settings:"wdth" 54,"opsz" 144;font-weight:400}
.mp-label{font-family:'Instrument Sans',sans-serif;font-weight:700;font-size:15px;letter-spacing:1px;text-transform:uppercase}
.mp-pill{display:inline-flex;align-items:center;min-height:46px;box-sizing:border-box;padding:12px 26px;border-radius:999px;font-family:'Instrument Sans',sans-serif;font-weight:700;font-size:14px;letter-spacing:0.6px;text-transform:uppercase;text-decoration:none}
a.mp-nav-link{color:#F7F0F5;text-decoration:none}
a.mp-nav-link:hover{text-decoration:underline;text-underline-offset:4px}
.mp-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:18px}
.mp-card{border:3px solid #120C1F;border-radius:18px;padding:24px 24px 26px}
@media (max-width:900px){.mp-nav{display:none!important}.mp-compose{display:none!important}}
@media (max-width:600px){.mp-wrap{padding-inline:16px}.mp-h1{font-size:60px!important}.mp-h2{font-size:44px!important}.mp-step{font-size:40px!important}.mp-lead{font-size:24px!important}.mp-rail{display:none!important}}
.mp-dev-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;margin-top:56px}.mp-dev-card{display:flex;flex-direction:column;gap:10px;padding:24px;background:#2C3C85;border:3px solid #120C1F;border-radius:18px;color:#F7F0F5;text-decoration:none}.mp-dev-card:hover{color:#F7F0F5;background:#34479A}.mp-dev-card:focus-visible{outline:3px solid #FFA5FF;outline-offset:3px}.mp-dev-card code{font-size:15px;color:#FDF152}.mp-dev-code{margin:16px 0 0;background:#0F1840;border:3px solid #120C1F;border-radius:18px;color:#DCD8FF;padding:28px;font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:14px;line-height:1.8;overflow-x:auto}
.mp-pillars{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;padding:0 0 112px}.mp-pillar{border-top:2px solid #FFA5FF;padding-top:18px;color:#F7F0F5}
.mp-spot{display:block;width:200px;height:auto;margin:0 0 20px -6px}
.mp-build-list{margin:32px 0 0;padding:0 0 0 1.1em;display:grid;gap:12px;font-size:18px;line-height:1.45}
.mp-form{display:grid;gap:14px;background:#FFFFFF;border:3px solid #120C1F;border-radius:18px;padding:28px}
.mp-field{display:grid;gap:6px;font-size:14px;font-weight:600}
.mp-field em{font-style:normal;font-weight:400;color:#4A4458}
.mp-field input,.mp-field textarea{box-sizing:border-box;width:100%;padding:12px 14px;border:2px solid #120C1F;border-radius:10px;font:inherit;font-weight:400;font-size:16px;background:#FFFFFF;color:#120C1F}
.mp-field input:focus,.mp-field textarea:focus{outline:3px solid #2350E6;outline-offset:1px}
.mp-trap{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}
.mp-form-note{margin:0;padding:12px 14px;border-radius:10px;font-weight:600;background:#C5E975}
.mp-form-note.is-error{background:#FFD3C9}
.mp-form-small{margin:0;font-size:14px;color:#4A4458}
</style>
</head>
