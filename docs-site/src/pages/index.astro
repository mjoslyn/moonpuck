<script is:inline>
// The contact form (worker.js, POST /api/contact): sent in place, its outcome shown above it. Without this
// it posts as usual and the page comes back with ?contact=<outcome>.
(() => {
  const form = document.querySelector('[data-contact]');
  if (!form) return;
  const outcome = form.querySelector('[data-contact-outcome]');
  const MESSAGES = { sent: 'Thank you: we will be in touch.', invalid: 'Please give a valid email address.', check: 'The check that you are a person did not pass. Please try again.', unavailable: 'Your message could not be sent just now. Please email info@moonpuck.com.' };
  const show = (text, error) => {
    outcome.textContent = text;
    outcome.hidden = false;
    outcome.classList.toggle('is-error', !!error);
  };
  const was = new URLSearchParams(location.search).get('contact');
  if (was && MESSAGES[was]) show(MESSAGES[was], was !== 'sent');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const button = form.querySelector('button[type="submit"]');
    button.disabled = true;
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const answer = await res.json().catch(() => null);
      show(answer?.message || MESSAGES.unavailable, !answer?.ok);
      if (answer?.ok) form.reset();
    } catch {
      show(MESSAGES.unavailable, true);
    }
    // A token is good once: a new one for the next try.
    window.turnstile?.reset?.();
    button.disabled = false;
  });
})();
</script>
